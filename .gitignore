# ==========================================
# SASOL CUSTOMER VALUE CHALLENGE
# Git ignore rules
# ==========================================

# Competition data - DO NOT COMMIT
data/raw/*
data/processed/*

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artefacts
models/*
!models/.gitkeep

# Generated outputs
outputs/*
!outputs/.gitkeep

# Competition submissions and any customer-level prediction file
submissions/*
!submissions/.gitkeep
**/*submission*.csv

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE/editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Secrets / environment variables
.env
*.env

# Logs
*.log

.venv*/

# Fitted dumps and archived prediction files. The method is in the source.
top4_submission/models/*
top4_submission/*.csv
submission_journal_2026-10-10/submissions/*.csv
submission_journal_2026-10-10/original_baseline/submission.csv
